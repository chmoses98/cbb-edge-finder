# ---------------------------------------------------------------------------
# cbb-edge-finder environment. COPY to .env only if you need to change a default.
# Every default below is the SAFE (zero-cost) value.
# ---------------------------------------------------------------------------

# The Odds API is PAID / METERED. Disabled by default. Both flags must be set
# (true AND a positive budget) before a single request is allowed.
ALLOW_PAID_ODDS_API=false
ODDS_API_MAX_REQUESTS=0
# ODDS_API_KEY=   # intentionally unset

# CollegeBasketballData: free tier is quota-limited per API key. Treated as
# UNKNOWN_COST until the owner confirms the plan. Disabled by default.
ALLOW_CBBD=false
CBBD_MAX_REQUESTS=0
# CBBD_API_KEY=

# Kalshi public market data (read-only, unauthenticated) is free.
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Local data lake root (gitignored)
CBB_DATA_DIR=data
